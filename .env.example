# Server mode settings. Copy to .env (`cp .env.example .env`) and edit.
# .env is excluded from git; never commit real values. Every value below is a placeholder.

# Address the published ports bind to on the host. 127.0.0.1 keeps everything on this machine.
# For access over a private network, set this to the address your mesh VPN gives this machine.
# Never set it to an all-interfaces address and never publish these ports to the internet.
SERVER_BIND_ADDRESS=127.0.0.1

# Name other staff use for this machine on the private network (documentation only).
PORTFOLIO_PRIVATE_HOSTNAME=your-private-hostname

# One timezone for every container: stored timestamps are naive local time.
TZ=UTC

# Staff login for anything that changes data in server mode, and the API write token.
# The value "change-me" is refused by the login, so the server cannot run on these examples.
PORTFOLIO_STAFF_USERNAME=change-me
PORTFOLIO_STAFF_PASSWORD=change-me
PORTFOLIO_API_TOKEN=change-me

# Backups: how often (seconds) and how many copies to keep.
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP=14
