# Copy to .env for server mode. .env is ignored by git; never commit real values.
# Every value below is a placeholder.

PORTFOLIO_MODE=server
PORTFOLIO_DB_PATH=/data/portfolio.db
# Address the apps listen on inside the private network (for example the machine's mesh VPN address).
PORTFOLIO_BIND_ADDRESS=0.0.0.0
PORTFOLIO_PRIVATE_HOSTNAME=your-private-hostname
# Staff login for anything that changes data in server mode.
PORTFOLIO_STAFF_USERNAME=change-me
PORTFOLIO_STAFF_PASSWORD=change-me
PORTFOLIO_API_TOKEN=change-me
PORTFOLIO_BACKUP_DIR=/backups
